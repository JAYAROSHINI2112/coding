prime = []
for i in range(1,15+1):
    flag = 0
    if i == 2 or i == 1:
        prime.append(i)
        continue
    
    for j in range(2,int(i**0.5)+1):
            if i % j == 0:
                flag = 1
                break;
                
    if flag == 0:
        prime.append(i)
    
print(prime)
